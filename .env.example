# ============================================================
# WorldQuant Alpha Miner 环境变量示例
#
# 用法：
#   cp .env.example .env      # 复制后填写真实值
# .env 含凭据，已被 .gitignore 忽略，不要提交或分享。
# 本文件中的所有值都是占位符，不能直接运行。
# ============================================================


# ------------------------------------------------------------
# 1. WorldQuant Brain 账号（必填）
# 缺失时 run_alpha_miner.py / submit_alpha.py 直接报错退出
# ------------------------------------------------------------
WQ_USERNAME=your_email@example.com
WQ_PASSWORD=your_password


# ------------------------------------------------------------
# 2. LLM 因子生成（远程接口与 Ollama 二选一，必填一项）
#
# run_alpha_miner.py --llm auto（默认）的选择规则：
#   配置了 LLM_API_KEY → 用下面的 OpenAI 兼容接口
#   未配置 LLM_API_KEY → 用本地 Ollama
# --llm deepseek 等价于 --llm llm，实际地址由 LLM_BASE_URL 决定
# ------------------------------------------------------------

# 2.1 OpenAI 兼容接口（推荐：无需本地 GPU）
LLM_API_KEY=sk-your_api_key
LLM_BASE_URL=https://your-llm-endpoint/v1
LLM_MODEL=your_model_name

# 2.2 本地 Ollama（不配 LLM_API_KEY 时生效）
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b


# ------------------------------------------------------------
# 3. 飞书群通知（可选）
# 不配置时只在本地写日志，不发任何消息
# 获取：飞书群 → 设置 → 群机器人 → 添加机器人 → 自定义机器人
# ------------------------------------------------------------
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx


# ------------------------------------------------------------
# 4. 飞书机器人指令控制（可选，feishu_bot.py 使用）
# 获取：飞书开放平台 → 开发者后台 → 应用 → 凭证与基础信息
# 事件订阅使用长连接（EventStream），不需要公网地址或端口
# ------------------------------------------------------------
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 指令白名单（必填）：只有这些 open_id 能执行 /start /stop /submit 等指令
# 多个用英文逗号分隔；留空或删除该行时，机器人会拒绝所有指令（fail-closed）
# 私聊和群聊都按此校验；不知道 open_id 时先随便发一条指令，拒绝日志会打印出来
FEISHU_ALLOWED_OPEN_IDS=ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ------------------------------------------------------------
# 5. 自动任务（可选，由 feishu_bot.py 启动时加载）
# ------------------------------------------------------------
# 定时语法：
#   单个整数 N（1-24）：每天 N 次，按 24/N 小时等分
#                      例：4 → 00:00 / 06:00 / 12:00 / 18:00
#   HH:MM             ：每天固定一个时间，例：04:00
#   HH:MM,HH:MM       ：每天多个固定时间，例：04:00,16:00
# 留空则关闭对应任务

# 5.1 相关性检查（check_correlation.py）
AUTO_CHECK_SCHEDULE=4
AUTO_CHECK_BATCH_SIZE=20

# 5.2 自动提交（会真实调用平台提交接口，不是演练）
AUTO_SUBMIT_SCHEDULE=14:30
# 每日提交上限
AUTO_SUBMIT_MAX_PER_DAY=4
# 每日目标提交数量：优先提交 HIGH 等级，不足时用 AVERAGE 补
AUTO_SUBMIT_MIN_PER_DAY=1
# 参与自动提交的最低 fitness
AUTO_SUBMIT_MIN_FITNESS=1.2


# ------------------------------------------------------------
# 6. 提交与清理行为（submit_alpha.py）
# ------------------------------------------------------------
# 提交请求体的 type 字段，默认 REGULAR；平台若要求其它类型再改
WQB_SUBMIT_TYPE=REGULAR
# true：平台明确返回 checks 失败时，从本地数据库删除该 alpha
# 命令行 --keep-failed 可临时覆盖本项
WQB_DELETE_ON_FAIL=true


# ------------------------------------------------------------
# 7. 其它可选配置
# ------------------------------------------------------------
# 覆盖 Ollama 默认模型（不写则读 data/model_config.json，再回退 qwen3.5:35b）
# WQ_DEFAULT_MODEL=qwen3.5:35b

# 由 feishu_bot.py 启动矿机时自动设置，手动运行请勿改动
# MINER_LOG_STREAM=0
